{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikislin/PyCamRec26/blob/main/schemas/task_quality_record_v1.schema.json",
  "title": "PyCamRec lossy-profile task quality record",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "status",
    "reference_dataset_sha256",
    "acceptance_criteria",
    "metrics",
    "evaluated_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "pass", "fail"]},
    "reference_dataset_sha256": {"type": "string", "pattern": "^$|^[a-fA-F0-9]{64}$"},
    "reference_dataset_name": {"type": "string"},
    "acceptance_criteria": {"type": "object", "minProperties": 1},
    "metrics": {"type": "object", "minProperties": 1},
    "evaluated_utc": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "validation_evidence": {
      "type": "object",
      "properties": {
        "summary_file": {"type": "string"},
        "sweep_completed_utc": {"type": "string", "format": "date-time"},
        "hardware_fingerprint_sha256_values": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        },
        "case_count": {"type": "integer", "minimum": 0},
        "acquisition_pass_count": {"type": "integer", "minimum": 0},
        "qc_pass_count": {"type": "integer", "minimum": 0},
        "evidence_ready_count": {"type": "integer", "minimum": 0},
        "all_acquisition_cases_pass": {"type": "boolean"},
        "all_qc_cases_pass": {"type": "boolean"},
        "all_evidence_cases_ready": {"type": "boolean"},
        "preview_modes_exercised": {
          "type": "array",
          "items": {"enum": ["on", "off"]}
        }
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
